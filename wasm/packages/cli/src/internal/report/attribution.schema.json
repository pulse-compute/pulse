{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pulse:report:attribution:v1",
  "type": "object",
  "properties": {
    "kind": {
      "const": "pulse.report-attribution"
    },
    "attributionVersion": {
      "const": 1
    },
    "artifactId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "artifactSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "stage": {
      "enum": [
        "final",
        "prelink"
      ]
    },
    "importedFunctions": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "functions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "index",
          "bytes"
        ],
        "additionalProperties": false
      },
      "maxItems": 100000
    },
    "handlerBodies": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "entryId": {
            "type": "string",
            "maxLength": 1048576,
            "minLength": 1
          },
          "handlerId": {
            "type": "string",
            "maxLength": 1048576,
            "minLength": 1
          },
          "chunks": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "maxItems": 100000
          }
        },
        "required": [
          "entryId",
          "handlerId",
          "chunks"
        ],
        "additionalProperties": false
      },
      "maxItems": 100000
    },
    "chunkMappings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "chunk": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "functionIndex": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "reason": {
            "anyOf": [
              {
                "enum": [
                  "missing-evidence",
                  "unsupported-mapping",
                  "incomplete-mapping",
                  "incomplete-root-universe",
                  "unsupported-call-graph",
                  "prelink-only",
                  "not-recorded",
                  "not-applicable",
                  "unsupported-schema-shape",
                  "unsupported-schema-version",
                  "unsupported-constraint",
                  "upstream-partial"
                ]
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "chunk",
          "functionIndex",
          "reason"
        ],
        "additionalProperties": false
      },
      "maxItems": 100000
    },
    "graph": {
      "type": "object",
      "properties": {
        "state": {
          "enum": [
            "available",
            "unavailable"
          ]
        },
        "reason": {
          "anyOf": [
            {
              "enum": [
                "missing-evidence",
                "unsupported-mapping",
                "incomplete-mapping",
                "incomplete-root-universe",
                "unsupported-call-graph",
                "prelink-only",
                "not-recorded",
                "not-applicable",
                "unsupported-schema-shape",
                "unsupported-schema-version",
                "unsupported-constraint",
                "upstream-partial"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "method": {
          "const": "static-direct-calls-v1"
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "caller": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "callee": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "sites": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "caller",
              "callee",
              "sites"
            ],
            "additionalProperties": false
          },
          "maxItems": 100000
        }
      },
      "required": [
        "state",
        "reason",
        "method",
        "edges"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "kind",
    "attributionVersion",
    "artifactId",
    "artifactSha256",
    "stage",
    "importedFunctions",
    "functions",
    "handlerBodies",
    "chunkMappings",
    "graph"
  ],
  "additionalProperties": false,
  "$defs": {}
}
