  "orderingFindings": [
    {
      "id": "javascript-clock-before-authenticity",
      "status": "must-change",
      "evidence": "verifyJwtWithJose captures currentDate before jose.jwtVerify",
      "requiredOrder": "crypto valid then claims parse then one wall-clock capture then registered claims"
    },
    {
      "id": "host-path-authenticity-order",
      "status": "reusable",
      "evidence": "verifyJwtWithHostCrypto parses claims, captures time, and invokes schema only after verifySignature returns true"
    },
    {
      "id": "payload-preflight-containment",
      "status": "reusable-with-explicit-guard",
      "evidence": "preflight decodes bounded payload text but does not parse, register, validate, or expose claims before authenticity"
    },
    {
      "id": "combined-jose-boundary",
      "status": "must-change",
      "evidence": "jose.jwtVerify combines authenticity and registered-claim validation, so JWT cannot demonstrate the required crypto seam"
    }
