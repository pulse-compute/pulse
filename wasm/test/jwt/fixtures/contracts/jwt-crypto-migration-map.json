  "evidenceClassification": {
    "observedFacts": [
      "The sealed Phase C contract and shared fourteen-case HS256 corpus are present.",
      "The ordered JWT build followed by the focused JWT and crypto tests passes.",
      "JWT has no direct @pulse-compute/crypto dependency or source import.",
      "Node JavaScript delegates authenticity and registered-claim validation to jose jwtVerify.",
      "Node Native delegates RS256 authenticity to a provider-owned Web Crypto verifier.",
      "Fastly JavaScript and Fastly Native do not currently execute JWT verification.",
      "Node and Fastly target descriptors already advertise the Phase C HS256 crypto realizations independently of JWT."
    ],
    "acceptedContracts": [
      "JWT owns compact JOSE parsing, protected-header policy, key selection, claims semantics, schema ordering, errors, redaction, and detached results.",
      "Crypto owns authentication of the exact JWS signing-input bytes and decoded authenticator bytes.",
      "The initial composed JWT surface supports HS256 verification only.",
      "JavaScript selects runtime-builtin and Native selects guest-source:pulse-hmac-as before execution.",
      "Selected realization failure never retries jose, a provider verifier, another target, or another realization."
    ],
    "inferences": [
      "The existing JWT semantic tests are reusable after their RS256 fixtures and backend call-count assertions are migrated to the HS256 crypto seam.",
      "The provider-owned secret and wall-clock authorities can remain while authenticity ownership moves to crypto."
    ],
    "unresolvedAssumptions": [
      "Production publication, deployment, and provider activation remain outside Phase D0.",
      "Browser and ESP32 target claims remain outside the initial cross-target proof."
    ]
  },
