    "runtimeRules": {
      "entry": {
        "kind": "string",
        "default": "./src/index.ts",
        "nonEmpty": true
      },
      "provider": {
        "kind": "provider-package",
        "default": "node",
        "builtinValues": [
          "node",
          "fastly",
          "none"
        ]
      },
      "outDir": {
        "kind": "string",
        "default": "./dist",
        "nonEmpty": true
      },
      "reporting": {
        "kind": "enum",
        "default": "info",
        "values": [
          "off",
          "error",
          "warn",
          "info",
          "debug"
        ]
      },
      "crypto": {
        "kind": "crypto-configuration",
        "optional": true
      },
      "schemas.contentTypePolicy": {
        "kind": "enum",
        "default": "accept-json-or-missing",
        "values": [
          "accept-json-or-missing",
          "require-json"
        ]
      },
      "schemas.maxBytes": {
        "kind": "positive-safe-integer",
        "default": 65536
      },
      "dev.host": {
        "kind": "string",
        "default": "127.0.0.1",
        "nonEmpty": true
      },
      "dev.port": {
        "kind": "integer",
        "default": 8787,
        "minimum": 0,
        "maximum": 65535
      },
      "dev.watch": {
        "kind": "boolean",
        "default": true
      },
