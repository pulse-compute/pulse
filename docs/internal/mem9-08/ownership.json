        "function pureLines",
        "function compileSequence",
        "host_value_truthy",
        "__pulse_helper_result = 0"
      ],
      "ownership": "Statement/loop/dispatch boundaries need empty-temporary proofs. Transfers must precede owner clearing."
    },
    {
      "id": "expression-borrows",
      "path": "wasm/packages/runtime-core-as/src/compiler/canonical-native-expressions.js",
