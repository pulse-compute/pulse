        "function renderPureHelper",
        "const result =",
        "arg_${i}: i32"
      ],
      "ownership": "Expression returns can borrow. Caller operands and helper native arguments may remain live outside global slots; no inner checkpoint without explicit roots."
    },
    {
      "id": "shared-stage-results",
      "path": "wasm/packages/runtime-core-as/src/compiler/shared-stage-accessors.js",
      "sha256": "943aea0195a056991129fa633c8db639bb366ad8eaea19a94896c3a008e6623a",
      "anchors": [
        "['prepare'",
        "['clear'",
        "['result'",
        "__pulse_effect_result_"
      ],
      "ownership": "Result handles survive flag clearing. This owner family is excluded from first-slice eligibility."
    },
    {
      "id": "fastly-value-graph",
      "path": "packages/provider-fastly/src/build/native-platform-capabilities.js",
      "sha256": "8571420454af4e2498706c639bd6c089eeda200ff547781fa7e59a239e2ca528",
      "anchors": [
        "class __PulseFastlyValue",
        "valuesStorage",
        "__pulse_fastly_values",
