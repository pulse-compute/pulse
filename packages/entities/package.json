{
  "name": "@pulse-compute/entities",
  "version": "1.0.0-beta.4",
  "license": "Apache-2.0",
  "engines": {
    "node": "^22.14.0 || ^24.0.0"
  },
  "description": "Bounded, statically declared entity dispatch contracts for Pulse.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./pulsewasm/manifest": {
      "require": "./pulsewasm.manifest.cjs",
      "default": "./pulsewasm.manifest.cjs"
    },
    "./pulsewasm/compiler": {
      "require": "./pulsewasm.compiler.cjs",
      "default": "./pulsewasm.compiler.cjs"
    },
    "./pulsewasm-native": {
      "require": "./pulsewasm.native.cjs",
      "default": "./pulsewasm.native.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "pulse.package.json",
    "pulsewasm.manifest.cjs",
    "pulsewasm.compiler.cjs",
    "pulsewasm.native.cjs",
    "as",
    "conformance"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "corepack pnpm --dir ../.. exec vitest run packages/entities/test"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pulse-compute/pulse.git",
    "directory": "packages/entities"
  },
  "bugs": {
    "url": "https://github.com/pulse-compute/pulse/issues"
  },
  "homepage": "https://pulsecompute.io/v1.0.0-beta.4/packages/entities/",
  "pulse": {
    "contract": "./pulse.package.json"
  },
  "pulsewasm": {
    "manifest": "./pulsewasm.manifest.cjs"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "dependencies": {
    "@pulse-compute/runtime": "workspace:*",
    "@pulse-compute/wasm-contracts": "workspace:*"
  }
}
