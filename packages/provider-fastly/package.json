      "import": "./dist/index.js",
      "require": "./src/config-api.js",
      "default": "./src/config-api.js"
    },
    "./contract": "./src/provider-contract.js",
    "./build/canonical-target": "./src/build/canonical-target.js",
    "./javascript/target": "./src/javascript/target.js",
    "./javascript/support": "./src/javascript/support.js",
    "./javascript/target-support-policy": "./src/javascript/target-support-policy.js",
    "./javascript/runtime-host": "./src/javascript/runtime-host.js",
    "./javascript/jwt-verifier": "./src/javascript/jwt-verifier.js",
    "./javascript/lifecycle": "./src/javascript/lifecycle.js",
    "./javascript/test-runtime": "./src/javascript/test-runtime.js",
    "./javascript/local-loader": "./src/javascript/local-loader.js",
    "./javascript/source-package": "./src/javascript/source-package.js",
    "./runtime/canonical-api-runtime": "./src/runtime/canonical-api-runtime.js",
    "./testing/fastly-cli": "./src/testing/fastly-cli.js",
    "./toolchain": "./src/toolchain/index.js",
    "./toolchain/config": "./src/toolchain/config.js",
    "./config-schema": {
      "types": "./src/config-schema.d.ts",
      "require": "./src/config-schema.js",
      "default": "./src/config-schema.js"
    }
  },
  "dependencies": {
    "@pulse-compute/crypto": "workspace:*",
    "@pulse-compute/jwt": "workspace:*",
    "@pulse-compute/runtime": "workspace:*",
    "@pulse-compute/wasm-build-support": "workspace:*",
    "@pulse-compute/wasm-contracts": "workspace:*",
    "@pulse-compute/wasm-guest-link": "workspace:*",
    "@pulse-compute/wasm-host-runtime": "workspace:*",
    "@pulse-compute/wasm-runtime-core-as": "workspace:*",
    "esbuild": "0.28.1",
    "@pulse-compute/s3": "workspace:*"
  },
  "devDependencies": {
    "@fastly/js-compute": "3.43.1"
