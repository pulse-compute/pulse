    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pulse-compute/pulse.git",
    "directory": "packages/provider-fastly"
  },
  "homepage": "https://pulsecompute.io/v1.0.0-beta.5/packages/provider-fastly/",
  "bugs": {
    "url": "https://github.com/pulse-compute/pulse/issues"
  }
