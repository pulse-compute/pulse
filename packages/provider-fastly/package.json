      "require": "./src/index.js",
      "default": "./src/index.js"
    },
    "./compiler": "./src/compiler/index.js",
    "./compiler/fastly-readiness": "./src/compiler/fastly-readiness.js",
    "./compiler/fastly-hostcall-binding": "./src/compiler/fastly-hostcall-binding.js",
    "./compiler/fastly-adapter": "./src/compiler/fastly-adapter.js",
    "./compiler/fastly-command-entry": "./src/compiler/fastly-command-entry.js",
    "./compiler/fastly-config-secret-serve": "./src/compiler/fastly-config-secret-serve.js",
    "./compiler/config-provider-resolution": "./src/compiler/config-provider-resolution.js",
    "./compiler/runtime-provider-kv": "./src/compiler/runtime-provider-kv.js",
    "./compiler/assets-provider-proof": "./src/compiler/assets-provider-proof.js",
