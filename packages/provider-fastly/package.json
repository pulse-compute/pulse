{
  "name": "@pulse-compute/provider-fastly",
  "version": "1.0.0-beta.5",
  "license": "Apache-2.0",
  "engines": {
    "node": "^22.14.0 || ^24.0.0"
  },
  "description": "Fastly provider configuration, contract-driven lowering, local conformance runtime, and PulseWasm target builders.",
  "type": "commonjs",
  "main": "./src/index.js",
  "exports": {
